<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="400.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17.0.7" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="friday.MainWindow">
    <children>
        <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="45.0"
                   promptText="Type a command..."
                   AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="12.0"
                   AnchorPane.rightAnchor="94.0" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                prefHeight="45.0" prefWidth="74.0" text="Send"
                AnchorPane.bottomAnchor="12.0" AnchorPane.rightAnchor="12.0" />
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" hvalue="1.0"
                    vvalue="1.0" AnchorPane.bottomAnchor="69.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" prefWidth="388.0" spacing="4.0">
                    <padding>
                        <Insets bottom="8.0" left="4.0" right="4.0" top="8.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
